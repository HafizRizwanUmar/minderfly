{
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "www.minderfly.com"
                }
            ],
            "destination": "https://minderfly.com/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/((?!api/|.*\\.).*)",
            "destination": "/index.html"
        }
    ]
}